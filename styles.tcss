/* Theme & Global Layout */
Screen {
    background: #0b0e14;
    color: #e6edf3;
}

#header-bar {
    height: 3;
    background: #161b22;
    border-bottom: solid #00ff9f;
    padding: 0 1;
    align: left middle;
}

#title-label {
    text-style: bold;
    color: #00ff9f;
}

#subtitle-label {
    color: #8b949e;
    margin-left: 2;
    width: 1fr;
}

#ssl-badge {
    color: #3fb950;
    text-style: bold;
    margin-right: 1;
    padding: 0 1;
    background: #161b22;
    border: solid #238636;
}

#ssl-badge.insecure {
    color: #f85149;
    border: solid #da3633;
}

#main-container {
    height: 1fr;
}

/* Sidebar */
#sidebar {
    width: 32;
    background: #0d1117;
    border-right: solid #30363d;
    padding: 1;
}

#sidebar-header {
    height: 3;
    margin-bottom: 1;
    align: left middle;
}

#sidebar-title {
    text-style: bold;
    color: #58a6ff;
    width: 1fr;
}

#requests-list {
    height: 1fr;
    background: transparent;
}

/* Buttons */
Button, Button.-style-default, Button.-style-flat {
    border: none !important;
    border-top: none !important;
    border-bottom: none !important;
    border-left: none !important;
    border-right: none !important;
    height: 3;
    min-width: 8;
    content-align: center middle;
    text-style: bold;
}

#new-req-btn {
    width: 8;
    background: #21262d;
    color: #58a6ff;
}

#new-req-btn:hover {
    background: #30363d;
}

#send-btn {
    width: 12;
    background: #238636;
    color: #ffffff;
    margin-left: 1;
}

#send-btn:hover {
    background: #2ea043;
}

#save-btn {
    width: 10;
    background: #1f6feb;
    color: #ffffff;
    margin-left: 1;
}

#save-btn:hover {
    background: #388bfd;
}

/* Main Request Bar */
#content-area {
    width: 1fr;
    padding: 1;
}

#request-bar {
    height: 3;
    margin-bottom: 1;
    layout: horizontal;
}

Select {
    width: 14;
    margin-right: 1;
    border: none !important;
}

SelectCurrent {
    border: solid #30363d !important;
    border-top: solid #30363d !important;
    border-bottom: solid #30363d !important;
    border-left: solid #30363d !important;
    border-right: solid #30363d !important;
    height: 3;
    background: #161b22;
    color: #f0f6fc;
}

SelectCurrent:focus {
    border: solid #58a6ff !important;
}

/* Dropdown Menu */
SelectOverlay, OptionList {
    border: solid #30363d !important;
    background: #161b22;
}

SelectOverlay:focus, OptionList:focus {
    border: solid #58a6ff !important;
}

OptionList > .option-list--option-highlighted {
    background: #1f6feb !important;
    color: #ffffff !important;
}

Input, #url-input {
    width: 1fr;
    background: #161b22;
    border: solid #30363d !important;
    border-top: solid #30363d !important;
    border-bottom: solid #30363d !important;
    color: #f0f6fc;
    height: 3;
}

Input:focus, #url-input:focus {
    border: solid #58a6ff !important;
}

/* Tabs & Panes */
#tabs {
    margin-bottom: 1;
}

TextArea, TextArea:focus, #body-input, #body-input:focus, #headers-input, #headers-input:focus {
    height: 1fr;
    background: #161b22;
    border: solid #30363d !important;
    color: #79c0ff;
}

#tab-headers-pane {
    height: 1fr;
    background: #0d1117;
    padding: 0;
}

#tab-response-pane {
    height: 1fr;
    background: #0d1117;
    border: solid #30363d;
    padding: 1;
}

#response-area, #response-area:focus {
    height: 1fr;
    background: #0d1117;
    border: none !important;
    color: #e6edf3;
}

#metrics-bar {
    height: 1;
    margin-bottom: 1;
    color: #8b949e;
    text-style: bold;
}

#tab-webhook-pane {
    height: 1fr;
    background: #0d1117;
    padding: 1;
}

#webhook-status {
    height: 3;
    padding: 0 1;
    align: left middle;
    background: #161b22;
    border: solid #30363d;
    margin-bottom: 1;
}

#webhook-toggle-btn {
    width: 20;
    margin-left: 2;
    background: #21262d;
    color: #e6edf3;
}

#webhook-toggle-btn:hover {
    background: #30363d;
}

/* Footer */
#footer-bar {
    height: 1;
    background: #161b22;
    color: #8b949e;
    padding: 0 1;
}
