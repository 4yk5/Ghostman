/* Ghostman — Cyberpunk Dark Theme */

Screen {
    background: #0b0e14;
    color: #e6edf3;
}

/* ── Header ── */
#header-bar {
    height: 3;
    background: #161b22;
    border-bottom: solid #00ff9f;
    padding: 0 1;
    align: left middle;
}

#title-label {
    text-style: bold;
    color: #00ff9f;
}

#subtitle-label {
    color: #8b949e;
    margin-left: 2;
}

#env-indicator {
    color: #f0883e;
    margin-left: 2;
    text-style: bold;
}

/* ── Layout ── */
#main-container {
    height: 1fr;
}

/* ── Sidebar ── */
#sidebar {
    width: 32;
    background: #0d1117;
    border-right: solid #21262d;
    padding: 1;
}

#sidebar-header {
    height: 3;
    margin-bottom: 1;
    align: left middle;
}

#sidebar-title {
    text-style: bold;
    color: #58a6ff;
    width: 1fr;
}

#requests-list {
    height: 1fr;
    background: transparent;
}

/* ── Buttons — flat, no border frame ── */
Button {
    border: none;
    height: 3;
    min-width: 8;
    content-align: center middle;
    text-style: bold;
}

#new-req-btn {
    width: 8;
    background: #21262d;
    color: #58a6ff;
}

#new-req-btn:hover {
    background: #30363d;
}

#send-btn {
    width: 12;
    background: #238636;
    color: #ffffff;
    margin-left: 1;
}

#send-btn:hover {
    background: #2ea043;
}

#save-btn {
    width: 10;
    background: #1f6feb;
    color: #ffffff;
    margin-left: 1;
}

#save-btn:hover {
    background: #388bfd;
}

/* ── Request Bar ── */
#content-area {
    width: 1fr;
    padding: 1;
}

#request-bar {
    height: 3;
    margin-bottom: 1;
}

/* ── Select / Dropdown ── */
Select {
    width: 14;
    margin-right: 1;
}

SelectCurrent {
    border: round #30363d;
    height: 3;
    background: #161b22;
    color: #f0f6fc;
}

SelectCurrent:focus {
    border: round #58a6ff;
}

SelectOverlay, OptionList {
    border: round #30363d;
    background: #161b22;
}

SelectOverlay:focus, OptionList:focus {
    border: round #58a6ff;
}

OptionList > .option-list--option-highlighted {
    background: #1f6feb;
    color: #ffffff;
}

/* ── Input ── */
Input {
    width: 1fr;
    background: #161b22;
    border: round #30363d;
    color: #f0f6fc;
    height: 3;
}

Input:focus {
    border: round #58a6ff;
}

/* ── Tabs ── */
#tabs {
    margin-bottom: 1;
}

/* ── Body Pane ── */
#tab-body-pane {
    height: 1fr;
}

/* ── Headers Pane ── */
#tab-headers-pane {
    height: 1fr;
}

/* ── Response Pane ── */
#tab-response-pane {
    height: 1fr;
    padding: 0 1;
}

#metrics-bar {
    height: 1;
    margin-bottom: 1;
    color: #8b949e;
    text-style: bold;
}

#response-area, #response-area:focus {
    height: 1fr;
    background: #0d1117;
    border: round #30363d;
    color: #e6edf3;
}

/* ── TextArea (shared) ── */
TextArea {
    height: 1fr;
    background: #161b22;
    border: round #30363d;
    color: #79c0ff;
}

TextArea:focus {
    border: round #58a6ff;
}

/* ── Webhook Pane ── */
#tab-webhook-pane {
    height: 1fr;
    padding: 1;
}

#webhook-status {
    height: 3;
    padding: 0 1;
    align: left middle;
    background: #161b22;
    border: round #30363d;
    margin-bottom: 1;
}

#webhook-toggle-btn {
    width: 20;
    margin-left: 2;
    background: #21262d;
    color: #e6edf3;
}

#webhook-toggle-btn:hover {
    background: #30363d;
}

#webhook-list {
    height: 1fr;
    background: transparent;
}

/* ── Environment Pane ── */
#tab-env-pane {
    height: 1fr;
    padding: 1;
}

#env-bar {
    height: 3;
    margin-bottom: 1;
}

#env-select {
    width: 24;
    margin-right: 1;
}

#env-name-input {
    width: 1fr;
    margin-right: 1;
}

#env-new-btn {
    width: 8;
    background: #238636;
    color: #ffffff;
    margin-right: 1;
}

#env-new-btn:hover {
    background: #2ea043;
}

#env-del-btn {
    width: 8;
    background: #da3633;
    color: #ffffff;
    margin-right: 1;
}

#env-del-btn:hover {
    background: #f85149;
}

#env-save-btn {
    width: 10;
    background: #1f6feb;
    color: #ffffff;
}

#env-save-btn:hover {
    background: #388bfd;
}

#env-hint {
    color: #8b949e;
    margin-bottom: 1;
}

/* ── Footer ── */
#footer-bar {
    height: 1;
    background: #161b22;
    color: #8b949e;
    padding: 0 1;
}
