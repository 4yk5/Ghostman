Screen {
    background: #0b0e14;
    color: #e6edf3;
}

#header-bar {
    height: 3;
    background: #161b22;
    border-bottom: heavy #00ff9f;
    padding: 0 1;
    align: left middle;
}

#title-label {
    text-style: bold;
    color: #00ff9f;
}

#subtitle-label {
    color: #8b949e;
    margin-left: 2;
}

#main-container {
    height: 1fr;
}

#sidebar {
    width: 32;
    background: #0d1117;
    border-right: solid #30363d;
    padding: 1;
}

#sidebar-header {
    height: 3;
    margin-bottom: 1;
    align: left middle;
}

#sidebar-title {
    text-style: bold;
    color: #58a6ff;
    width: 1fr;
}

#new-req-btn {
    width: 8;
    background: #21262d;
    color: #58a6ff;
    border: none;
}

#new-req-btn:hover {
    background: #30363d;
}

#requests-list {
    height: 1fr;
    background: transparent;
}

#content-area {
    width: 1fr;
    padding: 1;
}

#request-bar {
    height: 3;
    margin-bottom: 1;
    layout: horizontal;
}

#method-select {
    width: 14;
    margin-right: 1;
}

#url-input {
    width: 1fr;
    background: #161b22;
    border: tall #30363d;
    color: #f0f6fc;
}

#send-btn {
    width: 12;
    background: #238636;
    color: #ffffff;
    text-style: bold;
    margin-left: 1;
}

#send-btn:hover {
    background: #2ea043;
}

#save-btn {
    width: 10;
    background: #1f6feb;
    color: #ffffff;
    margin-left: 1;
}

#save-btn:hover {
    background: #388bfd;
}

#tabs {
    margin-bottom: 1;
}

#body-input {
    height: 1fr;
    background: #161b22;
    border: solid #30363d;
    color: #79c0ff;
}

#tab-response-pane {
    height: 1fr;
    background: #0d1117;
    border: solid #30363d;
    padding: 1;
}

#response-area {
    height: 1fr;
    background: #0d1117;
    border: none;
    color: #e6edf3;
}

#metrics-bar {
    height: 1;
    margin-bottom: 1;
    color: #8b949e;
    text-style: bold;
}

#tab-webhook-pane {
    height: 1fr;
    background: #0d1117;
    padding: 1;
}

#webhook-status {
    height: 3;
    padding: 0 1;
    align: left middle;
    background: #161b22;
    border: round #30363d;
    margin-bottom: 1;
}

#webhook-toggle-btn {
    width: 20;
    margin-left: 2;
}

#footer-bar {
    height: 1;
    background: #161b22;
    color: #8b949e;
    padding: 0 1;
}
